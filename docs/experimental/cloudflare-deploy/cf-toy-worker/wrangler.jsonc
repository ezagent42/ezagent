{
  // #65 toy demo Worker. Deploy order:
  //   1. `wrangler deploy` publishes to ezagent-cf-toy.<account>.workers.dev.
  //   2. Add toy.ezagent.chat as a new custom domain.
  //
  // Never touch the existing app./dev. tunnel records from this toy config.
  // Auth is via CLOUDFLARE_API_TOKEN in the environment.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezagent-cf-toy",
  "main": "src/index.js",
  "compatibility_date": "2026-06-21",
  "workers_dev": true,
  "routes": [
    { "pattern": "toy.ezagent.chat", "custom_domain": true }
  ]
}
