    {"type":"text","x":430,"y":620,"width":70,"height":15,"text":"CR 发布 →","fontSize":11,"strokeColor":"#f08c00"},
    {"type":"rectangle","x":30,"y":750,"width":900,"height":80,"strokeColor":"#1971c2","backgroundColor":"#e7f5ff","roundness":8},
    {"type":"text","x":340,"y":760,"width":280,"height":20,"text":"客户对话流程","fontSize":14,"textAlign":"center"},
    {"type":"text","x":60,"y":785,"width":850,"height":35,"text":"客户消息 → 即时安抚（快速AI ~1秒） → 正式回复（主AI ~30秒） → 门控检查 → 投递客户","fontSize":12,"strokeColor":"#495057"},
    {"type":"rectangle","x":30,"y":870,"width":900,"height":55,"strokeColor":"#e03131","backgroundColor":"#fff5f5","roundness":8},
    {"type":"text","x":320,"y":880,"width":320,"height":20,"text":"人工接管：AI暂停 → 客服接管 → 编辑回复 → 提交 → 客户看到","fontSize":13,"textAlign":"center","strokeColor":"#e03131"},
    {"type":"text","x":340,"y":945,"width":280,"height":15,"text":"Tenant 模板 | {{slot}} 填值 | sandbox→CR→release","fontSize":12,"textAlign":"center","strokeColor":"#868e96"},
