    {"type":"text","x":60,"y":125,"width":230,"height":55,"text":"· 创建租户\n· 管理平台模板\n· 设定 AI 模型","fontSize":12,"strokeColor":"#495057"},
    {"type":"rectangle","x":30,"y":230,"width":280,"height":100,"strokeColor":"#f08c00","backgroundColor":"#fff4e6","roundness":8},
