    {"type":"text","x":380,"y":125,"width":220,"height":55,"text":"· 与 AI 客服对话\n· 提出问题\n· 获得帮助","fontSize":12,"strokeColor":"#495057"},
    {"type":"rectangle","x":670,"y":230,"width":260,"height":100,"strokeColor":"#e03131","backgroundColor":"#fff5f5","roundness":8},
    {"type":"text","x":690,"y":240,"width":220,"height":20,"text":"人工客服 Operator","fontSize":14,"textAlign":"center"},
    {"type":"text","x":690,"y":265,"width":220,"height":55,"text":"· 查看会话列表\n· 接管客户对话\n· 直接回复客户","fontSize":12,"strokeColor":"#495057"},
    {"type":"rectangle","x":30,"y":400,"width":900,"height":130,"strokeColor":"#845ef7","backgroundColor":"#f8f0ff","roundness":8},
    {"type":"text","x":380,"y":410,"width":200,"height":20,"text":"AI 客服的三层"大脑"","fontSize":16,"textAlign":"center"},
    {"type":"rectangle","x":50,"y":440,"width":250,"height":75,"strokeColor":"#7950f2","backgroundColor":"#f3f0ff","roundness":6},
    {"type":"text","x":100,"y":448,"width":150,"height":18,"text":"Soul 灵魂","fontSize":14,"textAlign":"center"},
    {"type":"text","x":60,"y":470,"width":230,"height":40,"text":"我是谁 · 我该怎么做\n始终在 AI 记忆中（~30KB）\nL0框架 → L1平台 → L2行业 → L3租户","fontSize":11,"strokeColor":"#495057"},
    {"type":"rectangle","x":340,"y":440,"width":250,"height":75,"strokeColor":"#7950f2","backgroundColor":"#f3f0ff","roundness":6},
    {"type":"text","x":390,"y":448,"width":150,"height":18,"text":"Skill 技能","fontSize":14,"textAlign":"center"},
    {"type":"text","x":350,"y":470,"width":230,"height":40,"text":"我会处理什么场景\nAI 需要时才查阅（按需加载）\n4层优先：租户 > 行业 > 平台 > 框架","fontSize":11,"strokeColor":"#495057"},
    {"type":"rectangle","x":630,"y":440,"width":250,"height":75,"strokeColor":"#7950f2","backgroundColor":"#f3f0ff","roundness":6},
    {"type":"text","x":680,"y":448,"width":150,"height":18,"text":"KB 知识库","fontSize":14,"textAlign":"center"},
    {"type":"text","x":640,"y":470,"width":230,"height":40,"text":"我知道哪些事实\nAI 主动搜索查询（数据库）\n产品信息 · 术语表 · 触发词","fontSize":11,"strokeColor":"#495057"},
    {"type":"rectangle","x":30,"y":600,"width":430,"height":80,"strokeColor":"#f08c00","backgroundColor":"#fff9db","roundness":8},
    {"type":"text","x":160,"y":610,"width":170,"height":20,"text":"沙盒 Sandbox（草稿区）","fontSize":14,"textAlign":"center"},
    {"type":"text","x":45,"y":635,"width":400,"height":35,"text":"管理员编辑 Soul/Skill/KB → 预览测试 → 创建 CR → 发布","fontSize":12,"strokeColor":"#495057"},
    {"type":"rectangle","x":500,"y":600,"width":430,"height":80,"strokeColor":"#2f9e44","backgroundColor":"#ebfbee","roundness":8},
    {"type":"text","x":600,"y":610,"width":230,"height":20,"text":"生产 Release（已发布区）","fontSize":14,"textAlign":"center"},
