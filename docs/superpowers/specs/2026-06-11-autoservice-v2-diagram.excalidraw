    {"type":"text","x":55,"y":265,"width":240,"height":55,"text":"· 配置 AI 客服 Soul/Skill/KB\n· 预览测试\n· 审核发布\n· 管理人工客服","fontSize":12,"strokeColor":"#495057"},
    {"type":"rectangle","x":360,"y":90,"width":260,"height":100,"strokeColor":"#2f9e44","backgroundColor":"#ebfbee","roundness":8},
