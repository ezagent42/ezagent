# =============================================================================
# ezagent local environment variables — template
# =============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# .env is git-ignored — never commit real keys.
# =============================================================================

# --- LLM API keys ---
# Required for the fast (curl/DeepSeek) agent in autoservice.
# Without this, the fast agent posts a greeting but can't generate live replies.
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE

# Required for the slow (cc/Claude) agent when using --with-slow.
# If you proxy through DeepSeek, set ANTHROPIC_BASE_URL too.
ANTHROPIC_API_KEY=sk-YOUR_KEY_HERE
# Proxy Claude API through DeepSeek (optional — only needed for --with-slow):
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro

# --- Claude Code (optional — used by claude.sh launcher) ---
# Valid values: low | medium | high | max
CLAUDE_EFFORT=max
