# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/
/deps

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/


# Database files
*.db
*.db-*

# Claude Code worktrees
/.claude/worktrees/


# Local overrides for cc-bridge-attach.sh — proxy + creds, per operator.
scripts/cc-bridge-attach.local.sh

# Phase 1 v1_prototype: generated MCP config for cc-bridge-attach.
# Each operator has their own EZAGENT_BRIDGE_URL / proxy; gitignored.
.mcp.json
scripts/cc-bridge-attach.local.sh.bak-*
docs/phase-specs/phase3/artifacts/phase3-multi-agent*
/.ezagent/

# Cloudflare Access service-token credentials (operator-local).
# Allen 2026-05-18: moved to workspace for tunnel setup. Never commit.
.cf-access.env
.cf-access*.env

# Python bytecode cache
__pycache__/
*.pyc
.worktrees/
claude.sh
