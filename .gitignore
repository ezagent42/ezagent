# macOS Finder metadata — never track it anywhere in the tree.
.DS_Store

# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/
/deps

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/


# Database files
*.db
*.db-*

# Claude Code worktrees
/.claude/worktrees/


# Local overrides for cc-bridge-attach.sh — proxy + creds, per operator.
scripts/cc-bridge-attach.local.sh

# Phase 1 v1_prototype: generated MCP config for cc-bridge-attach.
# Each operator has their own EZAGENT_BRIDGE_URL / proxy; gitignored.
.mcp.json
scripts/cc-bridge-attach.local.sh.bak-*
docs/phase-specs/phase3/artifacts/phase3-multi-agent*
/.ezagent/

# Cloudflare Access service-token credentials (operator-local).
# Allen 2026-05-18: moved to workspace for tunnel setup. Never commit.
.cf-access.env
.cf-access*.env

# Local env vars (DEEPSEEK_KEY etc.) — operator-local, never commit.
.env

# deploy flow per-channel secrets (nightly/beta/stable + infra) — never commit.
docker/.env
docker/.env.*
!docker/.env.channel.example
docker/secrets-*/

# Python bytecode cache
__pycache__/
*.pyc
.worktrees/

# Superpowers v6.0.3+: per-worktree SDD scratch / progress ledger.
# Ignored so subagent-driven development can write here without touching .git.
.superpowers/

# Local Tailwind standalone binary (build artifact, do not commit)
tailwind-macos-arm64

# Local PG dev launcher (carries a local DB password default) — never commit.
bin/dev-pg

# Local helper script and JS dependencies.
claude.sh
node_modules/

# deploy flow logical backups (operator-local)
backups/
precommit.log
tailwind-linux-x64

# Playwright local artifacts (traces/screenshots/reports).
**/test-results/
**/playwright-report/
