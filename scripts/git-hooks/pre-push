#!/usr/bin/env bash
# ezagent pre-push deterministic gate (ci-health, #189).
#
# Runs the FAST, DB-free deterministic subset that the CI `gate` job enforces —
# NOT the full ~10-min concurrent suite (that runs post-merge as full-suite).
# Bypass (loudly discouraged) with:  git push --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# ── Skip conditions (same philosophy as sub-step-gate.sh #1601: a gate that
#    false-blocks a change it has nothing to say about teaches people to bypass
#    it). CI's `gate` job still enforces every check below on the PR. ──────────
#
# (A) Un-provisioned worktree: a fresh/linked checkout without fetched deps
#     cannot run any check — every `mix` call errors with "dependency is not
#     available", which misreads as a code failure. This is exactly what
#     false-blocked a docs/.sh push from a new worktree (2026-07-28).
if [ ! -d deps ]; then
  echo "⚠ pre-push gate SKIPPED — deps not fetched in this worktree"
  echo "  (run 'mix deps.get' to gate locally; CI's gate job still enforces these on your PR)."
  exit 0
fi

# (B) No gated source in the push: if the pushed commits touch no .ex/.exs/.heex
#     and no cc-sdk python, the deterministic gate has nothing to check. Read the
#     pushed refs from stdin and union their changed files. SAFE-BY-DEFAULT: on
#     ANY uncertainty (unresolvable range / missing base) fall through and run
#     the full gate — never skip on doubt.
_zero=0000000000000000000000000000000000000000
_gated_re='\.(ex|exs|heex)$|^apps/ezagent_plugin_cc/priv/python/.*\.py$'
_saw_ref=0; _saw_gated=0; _uncertain=0
while read -r _lref _loid _rref _roid; do
  [ -z "${_loid:-}" ] && continue
  [ "$_loid" = "$_zero" ] && continue          # deleting a ref: nothing to push
  _saw_ref=1
  if [ "${_roid:-$_zero}" != "$_zero" ] && git cat-file -e "$_roid" 2>/dev/null; then
    _range="${_roid}..${_loid}"                 # updating an existing remote ref
  else
    _base=$(git merge-base "$_loid" origin/main 2>/dev/null) # new branch: fork point
    if [ -n "$_base" ]; then _range="${_base}..${_loid}"; else _uncertain=1; break; fi
  fi
  if git diff --name-only "$_range" 2>/dev/null | grep -qE "$_gated_re"; then
    _saw_gated=1; break
  fi
done
if [ "$_saw_ref" = 1 ] && [ "$_uncertain" = 0 ] && [ "$_saw_gated" = 0 ]; then
  echo "✓ pre-push gate SKIPPED — pushed commits touch no .ex/.exs/.heex or cc-sdk python"
  echo "  (nothing deterministic to check; CI's gate job still enforces on the PR)."
  exit 0
fi

export MIX_ENV=test
fail=0

run() {
  local label="$1"; shift
  echo "── pre-push: ${label}"
  if ! "$@"; then
    echo "❌ pre-push check FAILED: ${label}"
    fail=1
  fi
}

run "compile (warnings-as-errors)" mix compile --warnings-as-errors --force
run "format --check-formatted"     mix format --check-formatted
run "ezagent.check_invariants"     mix ezagent.check_invariants
run "ezagent.uri_query.scan"       mix ezagent.uri_query.scan
run "cc-sdk-worker python unittest" \
  bash -c 'cd apps/ezagent_plugin_cc/priv/python && uv run --no-project python -m unittest test_ezagent_cc_sdk_worker'

if [ "${fail}" -ne 0 ]; then
  echo ""
  echo "======================================================================"
  echo " PUSH BLOCKED — the deterministic pre-push gate failed (see ❌ above)."
  echo " These are the SAME checks the CI 'gate' job enforces on your PR."
  echo " Fix them, or bypass with:  git push --no-verify"
  echo "======================================================================"
  exit 1
fi

echo "✓ pre-push deterministic gate: PASS"
exit 0
