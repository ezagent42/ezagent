# syntax=docker/dockerfile:1
# ezagent LOCAL UBUNTU CI image — THIN per-PR layer on top of `ezagent-ci-base`
# (docker/Dockerfile.ci-base: OS deps + Node 25 + pnpm 10.33.0 + hex/rebar +
# mix deps.get + pnpm install + mix deps.compile, all keyed on lockfiles).
# This file adds the cached Playwright browser runtime plus the per-PR source layer.
# Source-only changes still rebuild in seconds because the browser layer precedes
# `COPY . .`. Build via docker/build-ci-image.sh.
#
# The image runs `mix ci.local` (the alias that mirrors the CI step chain end-to-end:
# deps.get -> pnpm install -> ecto.create/migrate -> precommit -> check_invariants);
# its `precommit` force-recompiles the project against the base's warm deps `_build`,
# so no project-compile bake is needed here. Source lives in the image at /app (NOT
# a mac bind-mount) so virtiofs latency never perturbs scheduler/owner timing.
#
# Version pins live in docker/Dockerfile.ci-base — do not drift them.
ARG CI_BASE=ezagent-ci-base:latest
FROM ${CI_BASE}

# --- Ephemeral marker for the nightly disk sweep (scripts/nightly-cache-sweep.sh) ---
# This THIN per-PR image (built as `ci-gate-<run_id>-<attempt>-ci` by the CI gate and
# as `ezagent-ci-local` locally) is disposable: every gate run leaves one behind, and
# the compose `down -v` trap only tears down containers/volumes, never the built image.
# The label lets the sweep age-prune these safely (>24h) WITHOUT ever matching the base
# `ezagent-ci-base` (built from docker/Dockerfile.ci-base — NOT labeled, must survive:
# rebuilding it needs docker.io, which flakes through GFW) or the live deploy images.
# A LABEL in this child Dockerfile stamps ONLY this image, never the FROM base. Placed
# before `COPY . .` so it stays in the cached layer set. See docs/guide/nightly-cache-sweep.md.
LABEL ezagent.ephemeral="true"

WORKDIR /app

# Bake the lockfile-pinned Playwright Chromium runtime after the base image's asset
# installs but before source, so ordinary PR changes retain this expensive layer.
# `--with-deps` needs root for apt; the runtime browser remains readable by ezagent.
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers
USER root
RUN pnpm --dir apps/ezagent_plugin_world/assets exec playwright install --with-deps chromium \
    && chown -R ezagent:ezagent "${PLAYWRIGHT_BROWSERS_PATH}" \
    && rm -rf /var/lib/apt/lists/*

# Source now — this is the ONLY layer that changes per PR.
COPY . .
# The arch/invariant ExUnit suite locates the repo root via
# `git rev-parse --show-toplevel` and then enumerates source with `Path.wildcard`
# (see e.g. apps/ezagent_core/test/invariants/*_test.exs `repo_root/0`). The image
# carries the SOURCE but NOT `.git` (.dockerignore strips it → smaller, cache-stable
# image), so without a repo those tests crash `MatchError {"", 128}`. A minimal
# `git init` makes `rev-parse --show-toplevel` return /app; no history is needed —
# source is globbed from disk, and the one `git show origin/main:` drift-baseline
# lookup (architecture_case.exs) degrades to :ok exactly as on a shallow CI checkout
# that lacks the origin/main ref. Runs before chown so `.git` is owned by ezagent.
RUN git init -q . \
    && chmod +x docker/ci-runner.sh \
    && chown -R ezagent:ezagent /app /home/ezagent

# Run the suite as NON-ROOT (erlexec refuses root). /app (incl. _build / .mix) and
# /home/ezagent are owned by ezagent so the runtime user can recompile + run mix.
USER ezagent

ENTRYPOINT ["/app/docker/ci-runner.sh"]
