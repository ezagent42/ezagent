# syntax=docker/dockerfile:1
# ESR PROD image — multi-stage `mix release`. Builder compiles the release;
# the slim runtime carries the release + the CLIs agents shell out to
# (claude/codex/uv/node) + the feishu WS sidecar's node_modules (bundled into
# the release's priv at build time). NOT for dev (use Dockerfile.dev + phx.server).
# See docs/superpowers/specs/2026-06-04-dockerized-e2e-harness-design.md.
ARG ELIXIR_IMAGE=hexpm/elixir:1.19.5-erlang-28.4.2-debian-bookworm-20260518

# ============================ builder ============================
FROM ${ELIXIR_IMAGE} AS builder

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY="localhost,127.0.0.1,::1"
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} no_proxy=${NO_PROXY}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 MIX_ENV=prod DEBIAN_FRONTEND=noninteractive

# build deps: build-essential/pkg-config for native ports (erlexec C port,
# exqlite NIF); node for the web asset pipeline (esbuild/tailwind) + sidecar.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git tar ca-certificates curl xz-utils build-essential pkg-config \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Create the runtime user + HOME EARLY so COMPILE-TIME `~` expansions
# (e.g. McpConfigWriter `@default_dir Path.expand("~/.ezagent")`) bake
# /home/esr (matching the runtime user), not /root. Same lesson as Dockerfile.dev.
RUN useradd -m -u 1000 esr
ENV HOME=/home/esr

WORKDIR /app
RUN mix local.hex --force && mix local.rebar --force

COPY . .
# Resilient deps fetch (proxy to hex.pm is flaky under concurrency).
RUN ok=0; for i in 1 2 3 4 5; do \
      HEX_HTTP_CONCURRENCY=1 HEX_HTTP_TIMEOUT=180 mix deps.get --only prod && { ok=1; break; } || { echo "deps.get retry $i"; sleep 8; }; \
    done; \
    [ "$ok" = 1 ] || { echo "deps.get failed after 5 retries"; exit 1; }
RUN mix deps.compile
# Web assets: install standalone esbuild/tailwind + build digested prod assets.
RUN cd apps/ezagent_web && mix assets.setup && mix assets.deploy
# Feishu WS sidecar node deps — install INTO priv BEFORE `mix release` so the
# release bundles them (the release copies each app's priv/). Runtime only needs
# `node` to RUN main.js, not to install.
RUN cd apps/ezagent_plugin_feishu/priv/ws_sidecar && npm install --omit=dev
RUN mix compile
RUN mix release ezagent

# ============================ runtime ============================
# Same Debian base as the builder ERTS → NIF/port ABI compatibility (exqlite,
# erlexec). include_erts (mix release default) bundles ERTS, so no elixir/erlang
# install needed here — only the C libs they link + the agent CLIs.
FROM debian:bookworm-slim AS runtime

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY="localhost,127.0.0.1,::1"
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} no_proxy=${NO_PROXY}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 DEBIAN_FRONTEND=noninteractive

# Runtime libs (ERTS/NIF link targets) + node + agent CLIs (claude/codex/uv).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl bash openssl libstdc++6 libncurses6 locales procps \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm i -g @anthropic-ai/claude-code@2.1.162 @openai/codex@0.137.0 \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && cp /root/.local/bin/uv /usr/local/bin/uv \
    && rm -rf /var/lib/apt/lists/*

# Clear build-time proxy from the final image; runtime proxy comes from compose.
ENV HTTP_PROXY="" HTTPS_PROXY="" http_proxy="" https_proxy="" NO_PROXY="" no_proxy=""

RUN useradd -m -u 1000 esr
ENV HOME=/home/esr
WORKDIR /app

# The assembled release + the prod entrypoint.
COPY --from=builder --chown=esr:esr /app/_build/prod/rel/ezagent ./
COPY --chown=esr:esr docker/entrypoint.prod.sh /app/entrypoint.prod.sh
RUN chmod +x /app/entrypoint.prod.sh \
    && mkdir -p /data \
    && chown -R esr:esr /data /home/esr

USER esr
# erlexec's exec-port refuses to run as root + needs SHELL set.
ENV SHELL=/bin/bash
ENTRYPOINT ["/app/entrypoint.prod.sh"]
