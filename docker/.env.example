# docker/.env — compose interpolation values for the PROD stack (gitignored).
# Copy to docker/.env and fill in. `docker compose` auto-reads docker/.env when
# run from the docker/ dir, or pass --env-file docker/.env.
#
#   cp docker/.env.example docker/.env   # then edit

# Postgres password for the prod DB (used by both the postgres service and the
# ezagent DATABASE_URL). Generate a strong one, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Optional: override the Ecto pool size (default 5).
# POOL_SIZE=5

# Optional: override the egress proxy. Default is the containerized mihomo
# service (http://mihomo:7896). Set only to point agents at a different proxy.
# ESR_PROXY=http://mihomo:7896
