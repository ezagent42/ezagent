# docker/.env.channel.example — 复制为 docker/.env.<channel> 后填值(gitignored)
# nightly 示例;beta/stable 改 CHANNEL/EZAGENT_IMAGE/PUBLIC_HOST/HOST_ADMIN_PORT/SECRETS_DIR。
CHANNEL=nightly
EZAGENT_IMAGE=ezagent:nightly
PUBLIC_HOST=nightly.ezagent.chat
HOST_ADMIN_PORT=10041
SECRETS_DIR=./secrets-nightly
POSTGRES_PASSWORD=__CHANGE_ME__
DOCKER_BUILD_PROXY=http://host.docker.internal:7897
# 端口分配: nightly 10041 / beta 10042 / stable 10043(全绑 127.0.0.1)
