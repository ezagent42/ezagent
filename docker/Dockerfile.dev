# syntax=docker/dockerfile:1
# ezagent dev/test image — runs `mix phx.server` from a BLANK $EZAGENT_HOME, with the
# claude/codex/uv CLIs that agents shell out to. NOT a prod release (mix release is
# a later phase). See docs/superpowers/specs/2026-06-04-dockerized-e2e-harness-design.md.
FROM hexpm/elixir:1.19.5-erlang-28.4.2-debian-bookworm-20260518

# --- proxy: the host is behind a proxy (clash). Pass these as build args so apt /
#     npm / curl / hex can reach the internet. Inside Docker Desktop the host proxy
#     is reachable as host.docker.internal. ---
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY="localhost,127.0.0.1,::1"
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} no_proxy=${NO_PROXY}

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 MIX_ENV=dev DEBIAN_FRONTEND=noninteractive

# --- OS deps + Node 22 LTS (the claude/codex CLIs ship via npm) ---
# build-essential + pkg-config: native deps (erlexec C port, exqlite/sqlite) need make/gcc.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git tar ca-certificates curl xz-utils procps locales \
      build-essential pkg-config \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- agent CLIs on PATH (pinned to the host's working versions) ---
RUN npm i -g @anthropic-ai/claude-code@2.1.162 @openai/codex@0.137.0

# --- uv (MCP bridges run `uv run --script`) ---
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && cp /root/.local/bin/uv /usr/local/bin/uv

# --- agent-browser CLI: the CDP *client* only — NO Chrome in this image. ---
# The browser is the `chromium` sidecar (browserless) on the E2E stacks; in-container
# we always `agent-browser connect ws://chromium:3000/?token=…`, never `open` a local
# Chrome. So we install ONLY the prebuilt binary from the pinned GitHub release and
# deliberately do NOT run `agent-browser install` (which would pull a full Chrome).
# Pinned to the host's working version for reproducibility across the build-once ladder.
# Arch-aware: bookworm is glibc → agent-browser-linux-{x64,arm64}. (See spec §3.1 / OQ-1.)
ARG AGENT_BROWSER_VERSION=0.26.0
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) AB_ARCH=x64 ;; \
      arm64) AB_ARCH=arm64 ;; \
      *) echo "unsupported arch for agent-browser: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/agent-browser \
      "https://github.com/vercel-labs/agent-browser/releases/download/v${AGENT_BROWSER_VERSION}/agent-browser-linux-${AB_ARCH}"; \
    chmod +x /usr/local/bin/agent-browser; \
    agent-browser --version

# Create the non-root runtime user EARLY + set HOME, so COMPILE-TIME `~` expansions
# (e.g. `@default_dir Path.expand("~/.ezagent")` in McpConfigWriter) bake a path the
# runtime ezagent user can write — otherwise they freeze as `/root/.ezagent` (built as root)
# and fail at runtime with EACCES.
RUN useradd -m -u 1000 ezagent
ENV HOME=/home/ezagent

WORKDIR /app
# Install Hex/rebar into a shared MIX_HOME under /app (later chowned to the ezagent user) so
# the NON-ROOT runtime user can run mix (home.init / ecto.migrate / phx.server).
ENV MIX_HOME=/app/.mix
RUN mix local.hex --force && mix local.rebar --force

# --- deps + compile (dev). (Umbrella path-deps mean we can't cleanly pre-compile deps
#     before the source; .dockerignore strips _build/deps/node_modules/.git.) ---
COPY . .
# Resilient deps fetch: the proxy to hex.pm is flaky under concurrency — serialize +
# longer timeout + retry so a transient tarball timeout doesn't fail the whole build.
RUN ok=0; for i in 1 2 3 4 5; do \
      HEX_HTTP_CONCURRENCY=1 HEX_HTTP_TIMEOUT=180 mix deps.get && { ok=1; break; } || { echo "deps.get retry $i"; sleep 8; }; \
    done; \
    [ "$ok" = 1 ] || { echo "deps.get failed after 5 retries"; exit 1; }; \
    mix compile
# dev assets: install the standalone esbuild/tailwind binaries + precompile.
RUN cd apps/ezagent_web && mix assets.setup && mix assets.build
# feishu WS sidecar node deps (the real-Feishu inbound path needs @larksuiteoapi/node-sdk;
# .dockerignore strips the host node_modules so we install fresh for linux).
RUN cd apps/ezagent_plugin_feishu/priv/ws_sidecar && npm install --omit=dev

# Clear the build-time proxy from the FINAL image (codex r-review) — runtime proxy is
# supplied fresh by docker-compose (both upper + lower case), Feishu must go direct.
ENV HTTP_PROXY="" HTTPS_PROXY="" http_proxy="" https_proxy="" NO_PROXY="" no_proxy=""

RUN chmod +x docker/entrypoint.sh

# Run as NON-ROOT (ezagent created above): erlexec's exec-port refuses to run as root, and the
# host runs non-root. Own /app (incl. _build for dev recompile), /home/ezagent (compile-time ~
# paths), + the volume mountpoints so a FRESH named volume inherits writable ownership.
# (Recreate volumes with `down -v` after this change.)
RUN mkdir -p /data /cred/cc /cred/codex /layers \
    && chown -R ezagent:ezagent /app /home/ezagent /data /cred /layers
USER ezagent

ENTRYPOINT ["/app/docker/entrypoint.sh"]
